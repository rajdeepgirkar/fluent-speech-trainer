# This is an .env.examlple file NOT the actual .env
# You are required to create your own .env file, similar to this
# For MONGO_URI, go to the official MongoDB Atlas website, to get the connection string
# No need to change the Sever Port
# For JWT_SECRET, go to this website <https://jwtgenerator.com/tools/jwt-generator>    

# MongoDB Atlas connection string — replace with your own
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/fluent-speech-trainer?retryWrites=true&w=majority

# Server port
PORT=5000

# JWT secret key — change this in production
JWT_SECRET=fluent_speech_trainer_jwt_secret_2026
